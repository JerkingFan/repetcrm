# Пример nginx: https://repetcrm.ru → frontend, /api → backend
# Положить в /etc/nginx/sites-available/repetcrm и сделать symlink в sites-enabled
#
# limit_req_zone MUST be in http {} context (nginx.conf), not inside server {}.
# Add once to /etc/nginx/nginx.conf inside http { ... }:
#   limit_req_zone $binary_remote_addr zone=repetcrm_api:10m rate=10r/s;

upstream repetcrm_frontend {
    server 127.0.0.1:3000;
}

upstream repetcrm_backend {
    server 127.0.0.1:8000;
}

server {
    listen 80;
    server_name repetcrm.ru www.repetcrm.ru;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name repetcrm.ru www.repetcrm.ru;

    # ssl_certificate /etc/letsencrypt/live/repetcrm.ru/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/repetcrm.ru/privkey.pem;

    client_max_body_size 20M;

    # WebSocket доски (долгие уроки): отдельный location с увеличенным таймаутом
    location /api/boards/ws/ {
        proxy_pass http://repetcrm_backend/boards/ws/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /api/ {
        # Requires limit_req_zone in http {} (see header comment)
        limit_req zone=repetcrm_api burst=40 nodelay;
        proxy_pass http://repetcrm_backend/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 180s;
    }

    location / {
        proxy_pass http://repetcrm_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# Тогда в .env.production:
# NEXT_PUBLIC_API_URL=https://repetcrm.ru/api
# FRONTEND_PUBLIC_URL=https://repetcrm.ru
# CORS_ORIGINS=https://repetcrm.ru,https://www.repetcrm.ru
