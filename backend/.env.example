SECRET_KEY=change-me-in-production
# development | production (production: fail-fast on weak SECRET_KEY, hides /docs)
APP_ENV=development
# SQLite (простой деплой) или PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/repetcrm
DATABASE_URL=sqlite:///./data/repetcrm.db

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct
# Vision-модель для автопроверки фото решений (OpenRouter)
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
HOMEWORK_AI_REVIEW_ENABLED=true
OPENROUTER_TIMEOUT_SEC=120
OPENROUTER_MAX_TOKENS=4096

# Локальная Qwen (опционально, если без OpenRouter)
LOCAL_ENABLE_TRANSFORMERS=false
LOCAL_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
LOCAL_MODEL_DIR=./models/Qwen2.5-1.5B-Instruct
LOCAL_MODEL_MAX_TOKENS=1200
LOCAL_TRANSFORMERS_TIMEOUT_SEC=900
LOCAL_MODEL_PRELOAD=false

AI_USE_OLLAMA=false
AI_ALLOW_TEMPLATE_FALLBACK=true
# smart — быстро и без мусора от Llama; openrouter — нейросеть; auto = openrouter + fallback
HOMEWORK_AI_PROVIDER=smart
LATEX_ONLINE_COMPILE=true
LATEX_ONLINE_URL=https://latexonline.cc/compile
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_LOCALHOST_REGEX=true
MEDIA_DIR=./media

# Boards / Whiteboard safety
BOARD_ASSET_MAX_BYTES=10485760
BOARD_PERSIST_DEBOUNCE_SEC=6

# Brute-force protection (Redis required in production; dev falls back to in-memory)
AUTH_LOGIN_MAX_FAILURES=8
AUTH_LOGIN_WINDOW_SEC=60
AUTH_LOGIN_FAIL_DELAY_SEC=0.5
AUTH_REGISTER_MAX_PER_IP=5
AUTH_REGISTER_WINDOW_SEC=3600

# Redis — обязателен в production (rate limits, ARQ worker, board bus)
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# JWT: short access + refresh cookie
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

# PostgreSQL connection pool (ignored for SQLite)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Dashboard cache TTL (seconds)
DASHBOARD_CACHE_TTL_SEC=30

# SQLite backup on API startup (рекомендуется на проде)
SQLITE_BACKUP_ON_STARTUP=false
SQLITE_BACKUP_DIR=./data/backups
SQLITE_BACKUP_KEEP=14

# Password reset email (SMTP)
FRONTEND_PUBLIC_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
PASSWORD_RESET_EXPIRE_HOURS=24

# Notifications
TELEGRAM_BOT_TOKEN=
REMINDER_CRON_HOUR=18

# Online payments (webhook HMAC)
PAYMENT_WEBHOOK_SECRET=change-me-in-production

# Student portal session (days)
PORTAL_SESSION_EXPIRE_DAYS=30
HOMEWORK_SUBMISSION_MAX_BYTES=15728640

# API rate limit (global, per IP)
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_SEC=60

# Metrics (/metrics — set token in production)
METRICS_ENABLED=true
METRICS_TOKEN=

# Sentry (optional)
# SENTRY_DSN=
# SENTRY_RELEASE=repetcrm@1.0.0
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Board snapshots retention
BOARD_SNAPSHOT_KEEP=20

# Production safeguards
# PRODUCTION_MIN_USERS=1
# SQLITE_MIGRATION_COMPLETED=false
LOG_FORMAT=auto

# OpenRouter app metadata
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=RepetCRM

# Background jobs (in-memory MVP)
JOB_TTL_SEC=600
JOB_RETENTION_SEC=3600
AI_GLOBAL_CONCURRENCY=8
OPENROUTER_MAX_RETRIES=3
