# Скопируйте в .env.production на сервере и заполните значения
# cp .env.production.example .env.production

# === Публичные URL (как видит браузер пользователя) ===
# API через nginx на том же домене (рекомендуется):
NEXT_PUBLIC_API_URL=https://repetcrm.ru/api

# Ссылки кабинета ученика (/portal), родителя (/parent), запись на урок (/book)
FRONTEND_PUBLIC_URL=https://repetcrm.ru

FRONTEND_PORT=3000
BACKEND_PORT=8000

# === Безопасность ===
APP_ENV=production
SECRET_KEY=сгенерируйте-длинную-случайную-строку-минимум-32-символа
# Для HTTPS (repetcrm.ru):
COOKIE_SECURE=true

# === База данных (PostgreSQL по умолчанию в docker-compose.prod.yml) ===
POSTGRES_USER=repetcrm
POSTGRES_PASSWORD=strong-password-here
POSTGRES_DB=repetcrm
DATABASE_URL=postgresql+psycopg2://repetcrm:strong-password-here@db:5432/repetcrm

# Для локальной разработки без Docker можно оставить SQLite:
# DATABASE_URL=sqlite:///./data/repetcrm.db

# Миграция с SQLite volume (если уже есть пользователи):
# python backend/scripts/migrate_sqlite_to_postgres.py
# SQLITE_MIGRATION_COMPLETED=true

# === Uvicorn (backend API workers) ===
UVICORN_WORKERS=2

# === CORS (URL фронтенда через запятую) ===
CORS_ORIGINS=https://repetcrm.ru,https://www.repetcrm.ru
CORS_ALLOW_LOCALHOST_REGEX=false

# === OpenRouter (генерация ДЗ) ===
HOMEWORK_AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct
# Vision-модель для автопроверки фото решений ДЗ
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
HOMEWORK_AI_REVIEW_ENABLED=true
OPENROUTER_TIMEOUT_SEC=120
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_SITE_URL=https://repetcrm.ru
OPENROUTER_APP_NAME=RepetCRM

# === Локальные модели на сервере — обычно выключены ===
LOCAL_ENABLE_TRANSFORMERS=false
AI_USE_OLLAMA=false
AI_ALLOW_TEMPLATE_FALLBACK=true

# === PDF (LaTeX в облаке) ===
LATEX_ONLINE_COMPILE=true
LATEX_ONLINE_URL=https://latexonline.cc/compile

MEDIA_DIR=./media

# === Redis + ARQ worker (фоновые задачи AI/PDF) ===
# API_RATE_LIMIT_ENABLED=true
# API_RATE_LIMIT_MAX=120
# API_RATE_LIMIT_WINDOW_SEC=60

REDIS_PASSWORD=strong-redis-password-here
REDIS_URL=redis://:strong-redis-password-here@redis:6379/0

# === Наблюдаемость ===
# LOG_FORMAT=auto          # auto=json в production, text в dev
METRICS_ENABLED=true
METRICS_TOKEN=сгенерируйте-длинную-случайную-строку-для-metrics-минимум-32-символа

# === Sentry (опционально) ===
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_RELEASE=repetcrm@1.0.0
# SENTRY_TRACES_SAMPLE_RATE=0.1

# === Доска: снимки состояния (восстановление) ===
# BOARD_SNAPSHOT_KEEP=20

# === SQLite backup (рекомендуется на проде) ===
SQLITE_BACKUP_ON_STARTUP=true
SQLITE_BACKUP_DIR=./data/backups
SQLITE_BACKUP_KEEP=14

# === Онлайн-оплата (webhook HMAC от ЕРИП/эквайринга) — опционально до подключения шлюза ===
# PAYMENT_WEBHOOK_SECRET=

# === Кабинет ученика ===
PORTAL_SESSION_EXPIRE_DAYS=30
HOMEWORK_SUBMISSION_MAX_BYTES=15728640

# === Email (сброс пароля, напоминания) ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true
PASSWORD_RESET_EXPIRE_HOURS=24

# === Telegram-напоминания (бот @BotFather) ===
TELEGRAM_BOT_TOKEN=
REMINDER_CRON_HOUR=18
